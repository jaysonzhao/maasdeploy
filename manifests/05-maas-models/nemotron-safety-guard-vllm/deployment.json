{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "nemotron-safety-guard-vllm",
    "namespace": "llm",
    "labels": {
      "app.kubernetes.io/component": "model-server",
      "app.kubernetes.io/name": "nemotron-safety-guard-vllm"
    }
  },
  "spec": {
    "progressDeadlineSeconds": 600,
    "replicas": 1,
    "revisionHistoryLimit": 10,
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/name": "nemotron-safety-guard-vllm"
      }
    },
    "strategy": {
      "type": "Recreate"
    },
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/component": "model-server",
          "app.kubernetes.io/name": "nemotron-safety-guard-vllm"
        }
      },
      "spec": {
        "affinity": {
          "podAffinity": {
            "requiredDuringSchedulingIgnoredDuringExecution": [
              {
                "labelSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "redhataiqwen25-7b-instruct-vll"
                  }
                },
                "namespaces": [
                  "llm"
                ],
                "topologyKey": "kubernetes.io/hostname"
              }
            ]
          }
        },
        "containers": [
          {
            "args": [
              "--model=/models/hf/models--nvidia--Llama-3.1-Nemotron-Safety-Guard-8B-v3/snapshots/8fdc246ba3d56db9c469d534233b9f582d3afafa",
              "--served-model-name=nvidia/Llama-3.1-Nemotron-Safety-Guard-8B-v3",
              "--host=0.0.0.0",
              "--port=8000",
              "--dtype=bfloat16",
              "--max-model-len=8192",
              "--max-num-seqs=4",
              "--gpu-memory-utilization=0.48",
              "--disable-log-requests"
            ],
            "command": [
              "python",
              "-m",
              "vllm.entrypoints.openai.api_server"
            ],
            "env": [
              {
                "name": "HOME",
                "value": "/home"
              },
              {
                "name": "HF_HOME",
                "value": "/models/hf"
              },
              {
                "name": "HF_HUB_CACHE",
                "value": "/models/hf"
              },
              {
                "name": "HF_HUB_OFFLINE",
                "value": "1"
              },
              {
                "name": "TRANSFORMERS_OFFLINE",
                "value": "1"
              },
              {
                "name": "HF_HUB_DISABLE_TELEMETRY",
                "value": "1"
              },
              {
                "name": "VLLM_CACHE_ROOT",
                "value": "/tmp/vllm-cache"
              },
              {
                "name": "VLLM_LOGGING_LEVEL",
                "value": "INFO"
              }
            ],
            "image": "registry.redhat.io/rhaiis/vllm-cuda-rhel9:3.3.0",
            "imagePullPolicy": "IfNotPresent",
            "livenessProbe": {
              "failureThreshold": 3,
              "httpGet": {
                "path": "/health",
                "port": "http",
                "scheme": "HTTP"
              },
              "periodSeconds": 30,
              "successThreshold": 1,
              "timeoutSeconds": 5
            },
            "name": "vllm",
            "ports": [
              {
                "containerPort": 8000,
                "name": "http",
                "protocol": "TCP"
              }
            ],
            "readinessProbe": {
              "failureThreshold": 6,
              "httpGet": {
                "path": "/health",
                "port": "http",
                "scheme": "HTTP"
              },
              "periodSeconds": 10,
              "successThreshold": 1,
              "timeoutSeconds": 5
            },
            "resources": {
              "limits": {
                "cpu": "8",
                "memory": "48Gi",
                "nvidia.com/gpu": "1"
              },
              "requests": {
                "cpu": "4",
                "memory": "24Gi",
                "nvidia.com/gpu": "1"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "runAsNonRoot": true,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "startupProbe": {
              "failureThreshold": 360,
              "httpGet": {
                "path": "/health",
                "port": "http",
                "scheme": "HTTP"
              },
              "periodSeconds": 10,
              "successThreshold": 1,
              "timeoutSeconds": 5
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/models",
                "name": "model-cache"
              },
              {
                "mountPath": "/home",
                "name": "home"
              },
              {
                "mountPath": "/tmp",
                "name": "tmp"
              },
              {
                "mountPath": "/dev/shm",
                "name": "shm"
              }
            ]
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "initContainers": [
          {
            "args": [
              "from pathlib import Path\nfrom huggingface_hub import snapshot_download\n\nrepo = \"nvidia/Llama-3.1-Nemotron-Safety-Guard-8B-v3\"\nrevision = \"8fdc246ba3d56db9c469d534233b9f582d3afafa\"\ncache = Path(\"/models/hf\")\nsnapshot = cache / \"models--nvidia--Llama-3.1-Nemotron-Safety-Guard-8B-v3\" / \"snapshots\" / revision\nrequired = [\n    \"config.json\",\n    \"generation_config.json\",\n    \"model.safetensors.index.json\",\n    \"model-00001-of-00004.safetensors\",\n    \"model-00002-of-00004.safetensors\",\n    \"model-00003-of-00004.safetensors\",\n    \"model-00004-of-00004.safetensors\",\n    \"tokenizer.json\",\n    \"tokenizer_config.json\",\n]\nif not all((snapshot / name).is_file() for name in required):\n    snapshot_download(repo_id=repo, revision=revision, cache_dir=str(cache))\nif not all((snapshot / name).is_file() for name in required):\n    raise RuntimeError(\"Model cache is incomplete after Hugging Face download\")\nprint(f\"Model {repo}@{revision} is cached locally\")\n"
            ],
            "command": [
              "python",
              "-c"
            ],
            "env": [
              {
                "name": "HF_HOME",
                "value": "/models/hf"
              },
              {
                "name": "HF_HUB_OFFLINE",
                "value": "0"
              },
              {
                "name": "HF_HUB_DISABLE_TELEMETRY",
                "value": "1"
              }
            ],
            "image": "registry.redhat.io/rhaiis/vllm-cuda-rhel9:3.3.0",
            "imagePullPolicy": "IfNotPresent",
            "name": "fetch-model-if-missing",
            "resources": {
              "limits": {
                "cpu": "2",
                "memory": "4Gi"
              },
              "requests": {
                "cpu": "250m",
                "memory": "1Gi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "runAsNonRoot": true,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/models",
                "name": "model-cache"
              }
            ]
          }
        ],
        "nodeSelector": {
          "nvidia.com/device-plugin.config": "NVIDIA-L40S",
          "nvidia.com/gpu.present": "true"
        },
        "restartPolicy": "Always",
        "schedulerName": "default-scheduler",
        "securityContext": {},
        "terminationGracePeriodSeconds": 60,
        "volumes": [
          {
            "name": "model-cache",
            "persistentVolumeClaim": {
              "claimName": "nemotron-safety-guard-model-cache"
            }
          },
          {
            "emptyDir": {},
            "name": "home"
          },
          {
            "emptyDir": {},
            "name": "tmp"
          },
          {
            "emptyDir": {
              "medium": "Memory",
              "sizeLimit": "4Gi"
            },
            "name": "shm"
          }
        ]
      }
    }
  }
}
